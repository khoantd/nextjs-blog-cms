DATABASE_URL="file:./dev.db"
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here_generate_with_openssl_rand_base64_32

# Admin Configuration (comma-separated)
ADMIN_EMAILS=admin@example.com,khoa0702@gmail.com
ADMIN_DOMAINS=yourdomain.com,company.com

# LiteLLM Configuration
LITELLM_API_KEY=
LITELLM_BASE_URL=  # Your LiteLLM proxy URL

# Alpha Vantage Configuration (for earnings data)
ALPHA_VANTAGE_API_KEY=

# OpenAI Configuration (fallback if not using LiteLLM proxy)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Backend API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001  # Backend API base URL (default: http://localhost:3001)

# Vnstock API Configuration (for Vietnamese stock data)
NEXT_PUBLIC_VNSTOCK_API_URL=http://72.60.233.159:8002
